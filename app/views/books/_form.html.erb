<%= form_with model: @book do |f| %>

  <p>
    <%= f.label :title %>
    <%= f.text_field :title %>
  </p>

  <p>
    <%= f.label :author %>
    <%= f.text_field :author %>
  </p>

  <p>
    <%= f.label :price %>
    <%= f.number_field :price %>
  </p>

  <p>
    <%= f.label :published_on %>
    <%= f.date_field :published_on %>
  </p>

  <%= f.submit "登録" %>

<% end %>