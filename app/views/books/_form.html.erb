<%= form_with model: @book, class: "book-form" do |f| %>

  <% if @book.errors.any? %>
    <div class="error-box">
      <h3><%= @book.errors.count %>件のエラーがあります</h3>

      <ul>
        <% @book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= f.label :title, "タイトル" %>
    <%= f.text_field :title %>
  </div>

  <div class="form-field">
    <%= f.label :author, "著者" %>
    <%= f.text_field :author %>
  </div>

  <div class="form-field">
    <%= f.label :price, "価格" %>
    <%= f.number_field :price %>
  </div>

  <div class="form-field">
    <%= f.label :published_on, "出版日" %>
    <%= f.date_field :published_on %>
  </div>

  <div class="form-actions">
    <%= f.submit(@book.new_record? ? "書籍を登録" : "変更を保存", class: "submit-button") %>
  </div>
<% end %>