<section class="page-heading">
  <p class="page-eyebrow">BOOK DETAILS</p>
  <h1>書籍詳細</h1>
  <p>登録されている書籍の情報です。</p>
</section>

<dl class="book-details">
  <div>
    <dt>タイトル</dt>
    <dd><%= @book.title %></dd>
  </div>
  <div>
    <dt>著者</dt>
    <dd><%= @book.author %></dd>
  </div>
  <div>
    <dt>価格</dt>
    <dd><%= number_to_currency(@book.price, unit: "円", format: "%n%u", precision: 0) %></dd>
  </div>
  <div>
    <dt>出版日</dt>
    <dd><%= @book.published_on || "未登録" %></dd>
  </div>
</dl>

<nav class="detail-actions" aria-label="書籍の操作">
  <%= link_to "書籍を編集", edit_book_path(@book), class: "btn" %>
  <%= link_to "一覧へ戻る", books_path, class: "btn" %>
</nav>