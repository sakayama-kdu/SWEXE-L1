<section class="page-heading">
  <p class="page-eyebrow">YOUR COLLECTION</p>
  <h1>書籍一覧</h1>
  <p>登録した書籍を一覧で確認できます。</p>
</section>

<div class="list-toolbar">
  <p class="result-count">登録冊数 <strong><%= @books.size %></strong> 冊</p>
  <%= link_to "＋ 書籍を登録", new_book_path, class: "btn" %>
</div>

<% if @books.any? %>
  <div class="table-wrap">
    <table class="book-table">
      <thead>
        <tr>
          <th scope="col">タイトル</th>
          <th scope="col">著者</th>
          <th scope="col">価格</th>
          <th scope="col">操作</th>
        </tr>
      </thead>
      <tbody>
        <% @books.each do |book| %>
          <tr>
            <td><%= book.title %></td>
            <td><%= book.author %></td>
            <td><%= number_to_currency(book.price, unit: "円", format: "%n%u", precision: 0) %></td>
            <td>
              <%= link_to "詳細", book_path(book) %>
              <%= link_to "編集", edit_book_path(book) %>
              <%= link_to "削除",
                          book_path(book),
                          data: {
                            turbo_method: :delete,
                            turbo_confirm: "削除しますか？"
                          } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <section class="empty-state">
    <h2>まだ書籍がありません</h2>
    <p>最初の一冊を登録して、蔵書リストを作りましょう。</p>
    <%= link_to "書籍を登録する", new_book_path, class: "btn" %>
  </section>
<% end %>