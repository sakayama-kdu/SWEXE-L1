<h1>書籍一覧</h1>

<%= link_to "新規登録", new_book_path, class: "btn" %>

<table class="book-table">
  <tr>
    <th>タイトル</th>
    <th>著者</th>
    <th>価格</th>
    <th>操作</th>
  </tr>

  <% @books.each do |book| %>
    <tr>
      <td><%= book.title %></td>
      <td><%= book.author %></td>
      <td><%= book.price %>円</td>
      <td>
        <%= link_to "詳細", book_path(book) %> |
        <%= link_to "編集", edit_book_path(book) %> |
        <%= link_to "削除",
                    book_path(book),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "削除しますか？"
                    } %>
      </td>
    </tr>
  <% end %>
</table>